            "type": "string",
            "nullable": true
          },
          "ipN_Method": {
            "$ref": "#/components/schemas/HttpType"
          }
        },
        "additionalProperties": false
      },
      "PaymentResponseSettingGeneralResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "message": {
            "type": "string",
            "nullable": true
          },
          "body": {
            "$ref": "#/components/schemas/PaymentResponseSetting"
          }
        },
        "additionalProperties": false
      },
      "SelectItemModel": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "title": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "SelectItemModelListGeneralResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "message": {
            "type": "string",
            "nullable": true
          },
          "body": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SelectItemModel"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "SimpleResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "message": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "Speed": {
        "enum": [
          0,
          1
        ],
        "type": "integer",
        "format": "int32",
        "description": "0 High: the checkout tells the customer the payment was received once it is seen on-chain (mempool/block). 1 Low: the checkout waits for confirmations. Either way the order only becomes Paid (7) after the asset's required confirmations. Optional; defaults to 0."
      },
      "StringGeneralResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "description": "payment/request failures return HTTP 200 with success=false and a message; check it before using body."
          },
          "message": {
            "type": "string",
            "nullable": true
          },
          "body": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "VerifyRequest": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "VerifyResponse": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "nullable": true
          },
          "orderId": {
            "type": "string",
            "nullable": true
          },
          "orderStatus": {
            "$ref": "#/components/schemas/OrderStatus"
          },
          "additionalData": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AdditionalData"
            },
            "nullable": true
          },
          "settlement": {
            "allOf": [
              {
                "$ref": "#/components/schemas/SettlementResponse"
              }
            ],
            "nullable": true,
            "description": "Present for every authorized verify; omitted/null when the token is invalid."
          }
        },
        "additionalProperties": false
      },
      "VerifyResponseGeneralResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "description": "True only when the order is Approve after this call. False is NOT an error: branch on body.orderStatus; message \"Invalid Token\" means unknown token or another store's."
          },
          "message": {
            "type": "string",
            "nullable": true
          },
          "body": {
            "$ref": "#/components/schemas/VerifyResponse"
          }
        },
        "additionalProperties": false
      },
      "TransactionStatus": {
        "enum": [
          0,
          1,
          2,
          3,
          4,
          5,
          6
        ],
        "type": "integer",
        "format": "int32",
        "description": "0 Pending, 1 Mempool, 2 InBlock, 3 Completed, 4 Revert, 5 UnWatch, 6 Invalid. Serialized as an integer."
      },
      "SettlementTransactionResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "txHash": {
            "type": "string",
            "nullable": true
          },
          "explorerUrl": {
            "type": "string",
            "nullable": true,
            "description": "Block explorer link when configured."
          },
          "amount": {
            "type": "number",
            "format": "double",
            "nullable": true,
            "description": "Normalized amount credited for this transaction."
          },
          "confirmations": {
            "type": "integer",
            "format": "int32",
            "nullable": true,
            "description": "Null while there is no block height (e.g. mempool)."
          },
          "requiredConfirmations": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "status": {
            "$ref": "#/components/schemas/TransactionStatus"
          },
          "blockHeight": {
            "type": "integer",
            "format": "int64"
          },
          "detectedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "confirmedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "fromAddresses": {
            "type": "string",
            "nullable": true,
            "description": "Sender address(es) as stored (may be a JSON-encoded array string)."
          },
          "toAddress": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "SettlementResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "expectedCryptoAmount": {
            "type": "number",
            "format": "double",
            "nullable": true,
            "description": "Amount the customer was asked to pay (crypto)."
          },
          "requestedFiatAmount": {
            "type": "number",
            "format": "double",
            "nullable": true,
            "description": "Fiat amount quoted for the order, if set."
          },
          "pendingTxHash": {
            "type": "string",
            "nullable": true,
            "description": "Expected tx hash before any tx is persisted (wallet-signed flow)."
          },
          "toAddress": {
            "type": "string",
            "nullable": true,
            "description": "Deposit address for this payment."
          },
          "asset": {
            "type": "string",
            "nullable": true
          },
          "network": {
            "type": "string",
            "nullable": true
          },
          "standard": {
            "type": "string",
            "nullable": true,
            "description": "Native, ERC20, TRC20, SPL, ..."
          },
          "contractAddress": {
            "type": "string",
            "nullable": true
          },
          "receivedCryptoAmount": {
            "type": "number",
            "format": "double",
            "nullable": true,
            "description": "Sum credited from Mempool, InBlock and Completed transactions."
          },
          "transactions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SettlementTransactionResponse"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "ApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "Api-Key",
        "description": "Merchant API key from the Paymento dashboard."
      }
    }
  },
  "servers": [
    {
      "url": "https://api.paymento.io",
      "description": "Production"
    }
  ],
  "security": [
    {
      "ApiKey": []
    }
  ]
}